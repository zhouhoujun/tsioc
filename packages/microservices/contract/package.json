{
  "name": "@tsdi/microservice-contract",
  "version": "6.0.31",
  "description": "Contract-first DTO/OpenAPI/proto generation for @tsdi microservices.",
  "scripts": {
    "build": "ts-node -r tsconfig-paths/register taskfile.ts",
    "test": "ts-node -r tsconfig-paths/register unit.ts",
    "test:coverage": "NODE_V8_COVERAGE=.nyc_output ts-node -r tsconfig-paths/register unit.ts -c",
    "generate": "ts-node -r tsconfig-paths/register src/cli.ts"
  },
  "keywords": [
    "microservice",
    "contract",
    "openapi",
    "proto",
    "dto",
    "tsdi"
  ],
  "author": "houjun",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/zhouhoujun/tsioc/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhouhoujun/tsioc.git"
  },
  "homepage": "https://github.com/zhouhoujun/tsioc#readme",
  "dependencies": {
    "@tsdi/common": "6.0.31",
    "@tsdi/ioc": "6.0.31"
  },
  "devDependencies": {
    "@tsdi/compiler": "6.0.31",
    "@tsdi/unit": "6.0.31",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  }
}
