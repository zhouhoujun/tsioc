{
  "name": "@tsdi/activities",
  "version": "6.0.31",
  "description": "Type workflow frameworks, base on AOP, Ioc container, via @tsdi",
  "scripts": {
    "build": "ts-node -r tsconfig-paths/register taskfile.ts",
    "designer": "ts-node -r tsconfig-paths/register designer/build.ts && ts-node -r tsconfig-paths/register designer/serve.ts",
    "designer:build": "ts-node -r tsconfig-paths/register designer/build.ts",
    "designer:serve": "ts-node -r tsconfig-paths/register designer/serve.ts",
    "designer:test": "npm run designer:build && node designer/preview-test.js",
    "test": "ts-node -r tsconfig-paths/register unit.ts",
    "test:coverage": "NODE_V8_COVERAGE=.nyc_output ts-node -r tsconfig-paths/register unit.ts -c"
  },
  "keywords": [
    "activities",
    "activity",
    "workflow",
    "task",
    "framework",
    "AOP",
    "aop",
    "tsdi",
    "@tsdi",
    "tsioc",
    "ioc",
    "IoC",
    "type",
    "container",
    "dependency",
    "injection"
  ],
  "author": "houjun",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/zhouhoujun/tsioc/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhouhoujun/tsioc.git"
  },
  "homepage": "https://github.com/zhouhoujun/tsioc/blob/master/packages/activities#readme",
  "dependencies": {},
  "optionalDependencies": {
    "mqtt": "^4.3.8",
    "ioredis": "^5.4.1",
    "nats": "^2.28.2",
    "coap": "^1.4.1"
  }
}