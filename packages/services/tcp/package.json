{
  "name": "@tsdi/tcp",
  "version": "6.0.31",
  "description": "Application tcp service. base on AOP, Ioc container, via @tsdi/core.",
  "scripts": {
    "build": "ts-node -r tsconfig-paths/register taskfile.ts",
    "test": "ts-node -r tsconfig-paths/register unit.ts",
    "test:unit": "ts-node -r tsconfig-paths/register unit.ts --grep 'Unit'",
    "test:coverage": "nyc ts-node -r tsconfig-paths/register unit.ts"
  },
  "keywords": [
    "boot",
    "frameworks",
    "Application",
    "AOP",
    "aop",
    "tsdi",
    "@tsdi",
    "tsioc",
    "ioc",
    "IoC",
    "type",
    "container",
    "dependency",
    "injection"
  ],
  "author": "houjun",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zhouhoujun/tsioc/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhouhoujun/tsioc.git"
  },
  "homepage": "https://github.com/zhouhoujun/tsioc#readme",
  "dependencies": {
    "ws": "^8.5.0",
    "@types/ws": "^8.5.3"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  },
  "devDependencies": {
    "nyc": "^15.1.0",
    "@types/node": "^20.0.0"
  },
  "nyc": {
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "test/**/*.ts",
      "src/**/*.spec.ts"
    ],
    "extension": [
      ".ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "reporter": [
      "text",
      "text-summary",
      "html",
      "lcov"
    ],
    "sourceMap": true,
    "instrument": true,
    "watermarks": {
      "lines": [80, 95],
      "functions": [80, 95],
      "branches": [80, 95],
      "statements": [80, 95]
    }
  }
}