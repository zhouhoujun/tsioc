{
  "name": "@tsdi/agent-tools",
  "version": "6.0.31",
  "description": "Builtin tool bundles for @tsdi/agent.",
  "scripts": {
    "build": "ts-node -r tsconfig-paths/register taskfile.ts",
    "test": "ts-node -r tsconfig-paths/register unit.ts",
    "test:coverage": "NODE_V8_COVERAGE=.nyc_output ts-node -r tsconfig-paths/register unit.ts -c"
  },
  "keywords": [
    "agents",
    "tools",
    "llm",
    "search",
    "filesystem",
    "tsdi",
    "ioc"
  ],
  "author": "houjun",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/zhouhoujun/tsioc/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhouhoujun/tsioc.git"
  },
  "homepage": "https://github.com/zhouhoujun/tsioc#readme",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./files": {
      "types": "./files/index.d.ts",
      "default": "./files/index.js"
    },
    "./web": {
      "types": "./web/index.d.ts",
      "default": "./web/index.js"
    },
    "./browser": {
      "types": "./browser/index.d.ts",
      "default": "./browser/index.js"
    },
    "./sessions": {
      "types": "./sessions/index.d.ts",
      "default": "./sessions/index.js"
    },
    "./utility": {
      "types": "./utility/index.d.ts",
      "default": "./utility/index.js"
    },
    "./planning": {
      "types": "./planning/index.d.ts",
      "default": "./planning/index.js"
    },
    "./http": {
      "types": "./http/index.d.ts",
      "default": "./http/index.js"
    },
    "./registry": {
      "types": "./registry/index.d.ts",
      "default": "./registry/index.js"
    },
    "./skills": {
      "types": "./skills/index.d.ts",
      "default": "./skills/index.js"
    },
    "./mcp": {
      "types": "./mcp/index.d.ts",
      "default": "./mcp/index.js"
    },
    "./memory": {
      "types": "./memory/index.d.ts",
      "default": "./memory/index.js"
    },
    "./project": {
      "types": "./project/index.d.ts",
      "default": "./project/index.js"
    },
    "./process": {
      "types": "./process/index.d.ts",
      "default": "./process/index.js"
    },
    "./scheduling": {
      "types": "./scheduling/index.d.ts",
      "default": "./scheduling/index.js"
    },
    "./terminal": {
      "types": "./terminal/index.d.ts",
      "default": "./terminal/index.js"
    }
  },
  "dependencies": {
    "@tsdi/agent": "6.0.31",
    "@tsdi/ioc": "6.0.31",
    "cross-fetch": "^4.1.0",
    "globby": "^11.0.0",
    "parse5": "^8.0.0"
  },
  "directories": {
    "lib": "lib",
    "test": "test"
  }
}
