# OIDC_ISSUER=您的OIDC提供商地址
# OIDC_CLIENT_ID=客户端ID
# OIDC_CLIENT_SECRET=客户端密钥
# OIDC_CALLBACK_URL=回调地址

OIDC_ISSUER=https://your-oidc-provider.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_CALLBACK_URL=http://localhost:3000/auth/callback

# Local token signing
# OIDC_SESSION_SECRET=change-me
# JWT_SECRET=change-me
# OIDC_ACCESS_TOKEN_EXPIRES_IN=1h
# OIDC_REFRESH_TOKEN_EXPIRES_IN=7d
# OIDC_SESSION_EXPIRES_IN=24h

# Local registration (default false)
# OIDC_ALLOW_REGISTRATION=true

# Persistence (default: file-backed sql.js)
# OIDC_DB_TYPE=postgres
# OIDC_DB_HOST=localhost
# OIDC_DB_PORT=5432
# OIDC_DB_USERNAME=postgres
# OIDC_DB_PASSWORD=postgres
# OIDC_DB_NAME=oidc_auth
# OIDC_DB_LOCATION=oidc-auth.sqlite
# OIDC_DB_SYNC=true
