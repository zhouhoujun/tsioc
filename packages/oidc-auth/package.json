{
  "name": "@tsdi/oidc-auth",
  "version": "6.0.31",
  "description": "OIDC unified authentication service based on @tsdi/security and @tsdi/http-microservice.",
  "scripts": {
    "build": "ts-node -r tsconfig-paths/register taskfile.ts",
    "test": "ts-node -r tsconfig-paths/register unit.ts",
    "test:coverage": "NODE_V8_COVERAGE=.nyc_output ts-node -r tsconfig-paths/register unit.ts -c",
    "start": "ts-node -r tsconfig-paths/register main.ts"
  },
  "keywords": [
    "oidc",
    "openid",
    "authentication",
    "auth",
    "sso",
    "security",
    "tsdi",
    "@tsdi",
    "tsioc",
    "ioc",
    "IoC"
  ],
  "author": "houjun",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/zhouhoujun/tsioc/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zhouhoujun/tsioc.git"
  },
  "homepage": "https://github.com/zhouhoujun/tsioc#readme",
  "dependencies": {
    "@tsdi/ioc": "latest",
    "@tsdi/core": "latest",
    "@tsdi/aop": "latest",
    "@tsdi/security": "latest",
    "@tsdi/service": "latest",
    "@tsdi/http-microservice": "latest",
    "jsonwebtoken": "^9.0.0",
    "cross-fetch": "^4.1.0"
  },
  "directories": {
    "lib": "dist",
    "test": "test"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.0",
    "@tsdi/unit": "latest",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^4.9.0"
  }
}
