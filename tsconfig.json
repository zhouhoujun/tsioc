{
  "compilerOptions": {
    "importHelpers": true,
    "baseUrl": ".",
    "strict": true,
    "downlevelIteration": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": true,
    "sourceMap": true,
    "declaration": true,
    "module": "commonjs",
    "target": "es2020",
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "paths": {
      "@tsdi/agent-channels/*": [
        "packages/agents/agent-channels/*",
        "packages/agents/agent-channels/src/*"
      ],
      "@tsdi/agent-providers/*": [
        "packages/agents/agent-providers/*"
      ],
      "@tsdi/common/client": [
        "packages/services/client"
      ],
      "@tsdi/endpoints": [
        "packages/services/endpoints"
      ],
      "@tsdi/*": [
        "packages/*",
        "packages/microservices/*",
        "packages/agents/*"
      ]
    },
    "lib": [
      "dom",
      "es2015",
      "es2017",
      "es2020"
    ],
    "types": [
      "mocha",
      "node"
    ]
  },
  "exclude": [
    "test",
    "lib"
  ],
  "compileOnSave": false
}